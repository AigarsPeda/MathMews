# RevenueCat platform API keys — required for production App Store / Play Store builds.
# Get these from RevenueCat → Project Settings → API keys (iOS / Android, not Test Store).
# Development uses the Test Store key automatically when __DEV__ is true.

# TODO: RevenueCat Apple app public SDK key, appl_...
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# TODO: RevenueCat Google app public SDK key, goog_...
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=

# Supabase — cloud save (see doc/SUPABASE_PLAN.md)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

BD_PASSWORD=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# One Supabase project. Dev is always sandbox; production store builds use production.
# Only store-sandbox / preview builds set this to sandbox.
EXPO_PUBLIC_APP_ENVIRONMENT=
# Optional private local copy; never bundled into the app.
# TODO: Same VALUE as Supabase secret REVENUECAT_WEBHOOK_AUTHORIZATION and
# RevenueCat webhook Authorization header. Enter/save the credential yourself.
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Release identity. TODO: decide the legal publisher and a monitored support email.
EXPO_PUBLIC_PUBLISHER_NAME=
EXPO_PUBLIC_SUPPORT_EMAIL=
# TODO: enable each provider only after its credentials/redirects and identity
# linking are configured in Supabase and native protect/restore tests pass.
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
# GitHub Pages release drafts. TODO: finalize publisher/contact/privacy/deletion
# terms and verify these pages before store submission. Use the same URLs in EAS.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://aigarspeda.github.io/MathMews/privacy.html
EXPO_PUBLIC_SUPPORT_URL=https://aigarspeda.github.io/MathMews/support.html
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://aigarspeda.github.io/MathMews/delete-account.html

# SERVER ONLY. Set these in Supabase Edge Function Secrets when known.
# Never prefix these with EXPO_PUBLIC_ or put them in app.config.js extra.
# TODO: RevenueCat V2 secret API key, sk_...; customers read & write,
# purchases read only, products read only. Used for deletion and reconciliation.
REVENUECAT_SECRET_API_KEY=
# TODO: Apple Developer team ID, Sign in with Apple key ID, matching native
# bundle/client ID, and .p8 private key. Store multiline key in Supabase Secrets.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=

# SERVER ONLY. TODO: API v2 project ID from RevenueCat Project Settings.
# Use the API identifier, not a bundle ID, app ID or an assumed dashboard slug.
# Required scopes: customer_information:customers:read_write,
# customer_information:purchases:read, project_configuration:products:read.
REVENUECAT_PROJECT_ID=
