{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ENVIRONMENT": "sandbox"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_APP_ENVIRONMENT": "sandbox"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENVIRONMENT": "sandbox"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENVIRONMENT": "production"
      },
      "autoIncrement": true
    },
    "store-sandbox": {
      "distribution": "store",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENVIRONMENT": "sandbox"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
