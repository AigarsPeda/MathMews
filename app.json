{
  "expo": {
    "name": "Math Mews",
    "slug": "MathMews",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mathmews",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mathmews.app",
      "buildNumber": "2",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.mathmews.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF5EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-ios-pod-deployment-target",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "enableSceneSupport": true
          }
        }
      ],
      "expo-dev-client",
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-router",
      "./plugins/with-ios-launch-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-brand.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF5EB",
          "dark": {
            "backgroundColor": "#FFF5EB"
          },
          "imageWidth": 240,
          "ios": {
            "image": "./assets/images/splash-launch.png",
            "imageWidth": 320
          }
        }
      ],
      "expo-font",
      "expo-video",
      "expo-localization",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
