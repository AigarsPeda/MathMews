{
  "name": "math-mews",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "preios": "expo prebuild --platform ios --no-install --no-clean",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test:startup": "node scripts/check-native-launch.mjs && node scripts/check-splash-continuity.mjs && node scripts/check-startup-loading.mjs && node scripts/check-status-bar.mjs && node scripts/check-launch-links.mjs",
    "build:dev:ios": "npx eas-cli@24.10.0 build --profile development --platform ios",
    "build:dev:ios-device": "npx eas-cli@24.10.0 build --profile development-device --platform ios",
    "build:dev:android": "npx eas-cli@24.10.0 build --profile development --platform android",
    "licenses": "node scripts/licenses.mjs",
    "branding": "node scripts/generate-branding.mjs",
    "dependencies": "npm run licenses",
    "assets:3d": "node scripts/3d/build.mjs",
    "assets:verify": "node scripts/3d/verify.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "tsc --project supabase/functions/tsconfig.json",
    "test:backend": "node --test scripts/backend/test-*.mjs",
    "test:game": "node scripts/check-game.mjs",
    "test:puzzle-experience": "node scripts/check-puzzle-experience.mjs",
    "test:result-dismissal": "node scripts/check-result-dismissal.mjs",
    "test:cat-task-chains": "node scripts/check-cat-task-chains.mjs",
    "test:feeding-effects": "node scripts/check-native-room.mjs --feeding-effects",
    "test:ball-physics": "python3 scripts/native/check-ball-physics.py",
    "test:runtime-safety": "python3 scripts/native/check-runtime-safety.py",
    "crashes": "node scripts/diagnose-crashes.mjs",
    "assets:icons": "node scripts/3d/build-app-icons.mjs",
    "postinstall": "node scripts/native/patch-filament.mjs && node scripts/native/patch-expo-simulator-logs.mjs",
    "assets:native": "BRAINPET_BLENDER_ASSET_DIR=/tmp/brainpet-native-blends /Applications/Blender.app/Contents/MacOS/Blender --background --python-exit-code 1 --python scripts/3d/export-native.py",
    "test:recovery": "node scripts/check-crash-recovery.mjs",
    "animations:check": "node scripts/check-room-activities.mjs && node scripts/check-native-room.mjs",
    "assets:cat-thumbnails": "/Applications/Blender.app/Contents/MacOS/Blender --background --python-exit-code 1 --python scripts/3d/render-cat-thumbnails.py",
    "release:check": "node --env-file-if-exists=.env scripts/backend/check-release.mjs",
    "legal:generate": "node --env-file-if-exists=.env scripts/backend/generate-legal-pages.mjs",
    "release:android:pages": "python3 scripts/release/check-android-pages.py",
    "test:release": "python3 scripts/release/test_android_pages.py",
    "catalog:sync": "node scripts/catalog/sync.mjs",
    "catalog:check": "node scripts/catalog/sync.mjs --check",
    "catalog:build": "node scripts/catalog/build.mjs",
    "test:catalog": "node --test scripts/catalog/test-*.mjs scripts/backend/test-store-catalog.mjs",
    "puzzles:build": "node scripts/puzzles/build-content.mjs",
    "test:puzzles": "node scripts/check-curriculum.mjs && node scripts/check-puzzle-drag.mjs && node scripts/check-boss-assets.mjs && node scripts/check-puzzle-objects.mjs",
    "test:puzzles:ios": "node scripts/native/check-puzzle-drag.mjs",
    "test:puzzles:scenes:ios": "node scripts/native/check-puzzle-drag.mjs --scenes",
    "test:puzzles:companion:ios": "node scripts/native/check-puzzle-drag.mjs --companion",
    "assets:achievements": "node scripts/3d/pack-achievement-media.mjs",
    "test:achievements": "node scripts/check-achievement-media.mjs",
    "assets:bosses": "/Applications/Blender.app/Contents/MacOS/Blender --background --threads 2 --python-exit-code 1 --python scripts/3d/build-boss-scenes.py && node scripts/3d/pack-boss-scenes.mjs",
    "assets:lesson-bosses": "/Applications/Blender.app/Contents/MacOS/Blender --background --threads 2 --python-exit-code 1 --python scripts/3d/build-lesson-bosses.py && node scripts/3d/pack-lesson-bosses.mjs",
    "test:puzzles:bosses:ios": "node scripts/native/check-puzzle-drag.mjs --bosses",
    "assets:puzzle-objects": "/Applications/Blender.app/Contents/MacOS/Blender --background --threads 2 --python-exit-code 1 --python scripts/3d/build-puzzle-objects.py"
  },
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "^57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.20",
    "expo-auth-session": "~57.0.13",
    "expo-build-properties": "^57.0.22",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-filament": "1.11.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.11.0",
    "react-native-purchases-ui": "^10.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-worklets-core": "1.6.3",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
